# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Never commit .env.local. It's already in .gitignore.

# Postgres connection string. Adding Neon from the Vercel Marketplace sets this for you.
DATABASE_URL=

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake banks) or production (your real accounts). Use the matching secret.
PLAID_ENV=sandbox
# Only needed in production for banks that use OAuth (Chase, Capital One, ...).
# Set to https://<your-app>.vercel.app/oauth and add the same URL in Plaid's dashboard.
PLAID_REDIRECT_URI=

# Your app's public URL, used for the Plaid webhook. Leave blank locally.
# On Vercel it's detected automatically, but setting it explicitly is safer.
APP_URL=

# The only emails allowed to create accounts, comma separated.
ALLOWED_EMAILS=you@example.com,partner@example.com

# Random secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# Time zone for "this month" and "today". Defaults to America/New_York.
APP_TIMEZONE=America/New_York
